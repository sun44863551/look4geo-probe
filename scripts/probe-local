#!/bin/sh
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
LOCAL_ENV="$PROJECT_DIR/config/local.env"
REQUESTED_BROWSER_ID=${LOOK4GEO_BROWSER_ID-}

if [ -f "$LOCAL_ENV" ]; then
    set -a
    . "$LOCAL_ENV"
    set +a
fi

if [ -n "$REQUESTED_BROWSER_ID" ]; then
    export LOOK4GEO_BROWSER_ID="$REQUESTED_BROWSER_ID"
fi

if [ -n "${LOOK4GEO_LOCKED_BROWSER_ID-}" ]; then
    for PROBE_BROWSER_ID in "${LOOK4GEO_BROWSER_ID-}" "${LOOK4GEO_CHATGPT_BROWSER_ID-}" "${LOOK4GEO_GEMINI_BROWSER_ID-}"; do
        if [ "$PROBE_BROWSER_ID" != "$LOOK4GEO_LOCKED_BROWSER_ID" ]; then
            printf '%s\n' "Browser instance mismatch: this installation is locked to $LOOK4GEO_LOCKED_BROWSER_ID; reconnect the caller with matching configuration." >&2
            exit 2
        fi
    done
fi

exec "$PROJECT_DIR/.venv/bin/probe" "$@"
