#!/bin/sh
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
LOCAL_ENV=${LOOK4GEO_LOCAL_ENV:-"$PROJECT_DIR/config/local.env"}
if [ -n "${LOOK4GEO_LOCAL_ENV-}" ] && [ ! -r "$LOCAL_ENV" ]; then
    printf '%s\n' "Probe configuration is not readable: $LOCAL_ENV" >&2
    exit 2
fi
REQUESTED_BROWSER_ID=${LOOK4GEO_BROWSER_ID-}

if [ -f "$LOCAL_ENV" ]; then
    set -a
    . "$LOCAL_ENV"
    set +a
fi

if [ -n "$REQUESTED_BROWSER_ID" ]; then
    export LOOK4GEO_BROWSER_ID="$REQUESTED_BROWSER_ID"
fi

if [ -n "${LOOK4GEO_LOCKED_BROWSER_ID-}" ]; then
    for PROBE_BROWSER_ID in "${LOOK4GEO_BROWSER_ID-}" "${LOOK4GEO_CHATGPT_BROWSER_ID-}"; do
        if [ "$PROBE_BROWSER_ID" != "$LOOK4GEO_LOCKED_BROWSER_ID" ]; then
            printf '%s\n' "Browser instance mismatch: this installation is locked to $LOOK4GEO_LOCKED_BROWSER_ID; reconnect the caller with matching configuration." >&2
            exit 2
        fi
    done
    GEMINI_BROWSER_LOCK=${LOOK4GEO_LOCKED_GEMINI_BROWSER_ID:-$LOOK4GEO_LOCKED_BROWSER_ID}
    if [ "${LOOK4GEO_GEMINI_BROWSER_ID-}" != "$GEMINI_BROWSER_LOCK" ]; then
        printf '%s\n' "Gemini browser instance mismatch: this installation requires $GEMINI_BROWSER_LOCK." >&2
        exit 2
    fi
fi

exec "$PROJECT_DIR/.venv/bin/probe" "$@"
