{
  "mcpServers": {
    "look4geo-probe": {
      "type": "stdio",
      "command": "/ABSOLUTE/PATH/TO/look4geo-probe/.venv/bin/python",
      "args": ["-m", "look4geo_probe.mcp_server"],
      "env": {
        "LOOK4GEO_BROWSER_ID": "YOUR_LOCAL_BROWSER_ID"
      },
      "timeout": 30000
    }
  }
}
