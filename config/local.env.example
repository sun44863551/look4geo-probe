LOOK4GEO_BROWSER_ID=your-browser-instance-id
LOOK4GEO_CHATGPT_BROWSER_ID=your-dedicated-chatgpt-browser-instance-id
LOOK4GEO_GEMINI_BROWSER_ID=your-dedicated-gemini-browser-instance-id
LOOK4GEO_RUNTIME=workbuddy
LOOK4GEO_NODE=/absolute/path/to/node
LOOK4GEO_CAMOUFOX_ENABLED=1
LOOK4GEO_CAMOUFOX_PROFILE_DIR=/absolute/path/to/project/data/camoufox/profiles/gemini
LOOK4GEO_CAMOUFOX_BROWSER=152.0.4-beta.30
LOOK4GEO_CAMOUFOX_HEADLESS=0
# Enable only when a trusted local host such as WorkBuddy already provides an outer sandbox.
LOOK4GEO_CAMOUFOX_DISABLE_CONTENT_SANDBOX=0
